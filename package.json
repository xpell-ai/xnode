{
  "name": "@xpell/node",
  "version": "2.0.01",
  "publishConfig": {
    "access": "public"
  },
  "description": "XNode  Server for Node.js (Xpell-Node)",
  "files": [
    "dist",
    "src",
    "types",
    "docs"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "scripts": {
    "build": "tsc -p .&& npm run copy-assets",
    "test": "npm run build && node ./dist/test.js",
    "docs": "typedoc --options ./typedoc.json --tsconfig ./",
    "copy-assets": "cp -R ./public/assets ./dist/assets",
    "publish-alpha-next": "pnpm version prerelease --preid=alpha  && pnpm publish --tag alpha"
  },
  "author": "Tamir Fridman <tamir@aimeverse.com> (https://github.com/fridman-tamir)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AimeVerse/xpell-node"
  },
  "peerDependencies": {
    "@xpell/core": "^2.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-sslify": "^1.2.5",
    "@types/node": "^14.18.63",
    "@types/ws": "^8.18.1",
    "@xpell/core": "^2.0.0",
    "typescript": "^4.9.5"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-sslify": "^1.2.0",
    "mongoose": "^9.6.2",
    "ws": "^8.20.1"
  }
}
